{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheros.dev/schemas/device-state.json",
  "title": "DeviceState",
  "type": "object",
  "required": ["deviceId", "platform", "connected"],
  "properties": {
    "deviceId": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": ["android"]
    },
    "connected": {
      "type": "boolean"
    },
    "transport": {
      "type": "string",
      "enum": ["usb", "wifi", "lan", "relay"]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
